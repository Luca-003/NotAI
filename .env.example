# =============================================================================
# NotAI - environment example
# Copia in `.env` e personalizza. NON committare `.env`.
# =============================================================================

# --- General -----------------------------------------------------------------
NOTAI_ENV=dev
NOTAI_LOG_LEVEL=INFO
NOTAI_TZ=Europe/Rome

# --- Postgres ----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=notai_app
POSTGRES_PASSWORD=change_me_in_dev
POSTGRES_DB=notai
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser

# Ruoli applicativi creati dagli init script
POSTGRES_APP_ROLE=notai_app
POSTGRES_APP_PASSWORD=change_me_in_dev
POSTGRES_MIGRATOR_ROLE=notai_migrator
POSTGRES_MIGRATOR_PASSWORD=change_me_migrator
POSTGRES_AUDIT_WRITER_ROLE=notai_audit_writer
POSTGRES_AUDIT_WRITER_PASSWORD=change_me_audit

# Temporal DB separato
TEMPORAL_DB=temporal
TEMPORAL_VISIBILITY_DB=temporal_visibility

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=notai_minio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET_DOCUMENTS=notai-documents
MINIO_BUCKET_AUDIT=notai-audit-bundles
MINIO_BUCKET_MODELS=notai-llm-models

# --- OpenSearch --------------------------------------------------------------
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ChangeMeInDev123!

# --- Qdrant ------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=change_me_qdrant

# --- Vault -------------------------------------------------------------------
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=dev-only-root-token

# --- Temporal ----------------------------------------------------------------
TEMPORAL_HOST=temporal
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=notai
TEMPORAL_TASK_QUEUE=notai-main

# --- LLM / LiteLLM -----------------------------------------------------------
LITELLM_HOST=litellm
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-change-me-master

# --- Cloud LLM gratis (opzionale, raccomandato per demo) --------------------
# Per evitare di stressare la macchina con LLM locale (qwen2.5:7b su CPU
# impiega 30-70s per chunk), puoi usare provider cloud FREE. Nessuna carta
# di credito richiesta:
#
# 1) GROQ - Llama 3.3 70B, 30 req/min, 14400 req/giorno, latenza <1s
#    Signup: https://console.groq.com -> API Keys -> Create
#    Free tier: https://console.groq.com/docs/rate-limits
#
# 2) Google AI Studio - Gemini 2.0 Flash, 15 req/min, 1500 req/giorno
#    Signup: https://aistudio.google.com/apikey
#    Free tier: https://ai.google.dev/pricing
#
# Lasciale vuote se non vuoi usare cloud (l'app cade su Ollama locale).
GROQ_API_KEY=
GEMINI_API_KEY=

# --- LLM Routing: scelta modello per ruolo applicativo ----------------------
# L'app non parla mai direttamente di "qwen" o "llama": parla di RUOLI.
# I valori qui sono ALIAS definiti in docker/litellm/config*.yaml.
# Cambia il valore per swappare il modello senza toccare il codice.
#
# Profilo LOCAL (default - Ollama on host, no rete, lento su CPU):
#   NOTAI_LLM_*=local/qwen2.5-7b
#   NOTAI_LLM_EMBEDDINGS=local/embeddings
#
# Profilo CLOUD-FREE (Groq + Gemini, veloce, richiede API keys gratis):
#   NOTAI_LLM_GENERATION=cloud/groq-llama-70b
#   NOTAI_LLM_EXTRACTION=cloud/groq-llama-70b
#   NOTAI_LLM_CLASSIFICATION=cloud/groq-llama-8b   # piu' veloce, ok per tag
#   NOTAI_LLM_VERIFIER=cloud/gemini-flash-lite
#   NOTAI_LLM_EMBEDDINGS=local/embeddings          # bge-m3 e' leggero, lascialo locale
#
# Profilo MISTO (cloud per i task lenti, locale per quello che va bene veloce):
#   NOTAI_LLM_CLASSIFICATION=cloud/groq-llama-8b   # il piu' frequente
#   NOTAI_LLM_EXTRACTION=cloud/groq-llama-70b      # serve qualita' alta
#   altri local
NOTAI_LLM_GENERATION=local/qwen2.5-7b
NOTAI_LLM_EXTRACTION=local/qwen2.5-7b
NOTAI_LLM_EMBEDDINGS=local/embeddings
NOTAI_LLM_VERIFIER=local/qwen2.5-7b
NOTAI_LLM_CLASSIFICATION=local/qwen2.5-7b

# Discovery automatico: URL dell'API Ollama sull'host (per listare modelli installati)
NOTAI_LLM_OLLAMA_DISCOVERY_URL=http://host.docker.internal:11434

# vLLM (solo se compose.gpu.yml attivo)
VLLM_MODEL_PATH=/models/Qwen2.5-7B-Instruct
VLLM_PORT=8000

# llama.cpp (fallback CPU)
LLAMA_CPP_PORT=8080
LLAMA_CPP_MODEL=/models/qwen2.5-7b-instruct-q4_k_m.gguf

# --- API ---------------------------------------------------------------------
NOTAI_API_HOST=0.0.0.0
NOTAI_API_PORT=8000
NOTAI_API_WORKERS=2
NOTAI_API_PUBLIC_URL=https://notai.localhost
NOTAI_JWT_SECRET=change_me_jwt_secret_use_long_random
NOTAI_JWT_ALGO=HS256
NOTAI_JWT_TTL_SECONDS=3600
NOTAI_CORS_ORIGINS=http://localhost:5173,https://notai.localhost

# Audit hash chain
NOTAI_AUDIT_SIGNING_KEY_PATH=/run/secrets/notai_audit_signing.pem
NOTAI_AUDIT_TSA_URL=https://freetsa.org/tsr
NOTAI_AUDIT_TSA_HASH_ALGO=sha256

# --- Conservazione AgID ------------------------------------------------------
CONSERVATORE_PROVIDER=disabled
CONSERVATORE_ENDPOINT=
CONSERVATORE_USERNAME=
CONSERVATORE_PASSWORD=

# --- Observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=notai-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Web frontend ------------------------------------------------------------
WEB_API_BASE_URL=/api
WEB_PUBLIC_HOST=notai.localhost

# --- Smart card / firma client (NON containerizzato) -------------------------
# Riferimento informativo: il client desktop firma localmente con PKCS#11.
SIGNING_CLIENT_MTLS_CA=/run/secrets/signing_client_ca.pem
