# NotAI - Caddy reverse proxy.
# In dev usa nome locale; in prod sostituisci con il dominio reale e Caddy ottiene TLS via Let's Encrypt.

{
    # Auto-HTTPS in prod (commentare in dev se non si vuole TLS)
    auto_https disable_redirects
    admin off
}

notai.localhost, :80 {
    encode gzip zstd

    # Health endpoint pubblico per probe esterni
    handle /healthz {
        respond "ok" 200
    }

    # API
    handle /api/* {
        reverse_proxy notai-api:8000 {
            health_uri /health
            health_interval 10s
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Temporal UI dietro path admin (auth aggiuntiva da configurare in prod!)
    handle /admin/temporal/* {
        uri strip_prefix /admin/temporal
        reverse_proxy temporal-ui:8080
    }

    # Frontend SPA (catch-all)
    handle {
        reverse_proxy notai-web:80
    }

    log {
        output stdout
        format json
    }
}
